#!name=独立来源去广告净化合集（无 R-Store base）
#!desc=仅合并 Romeo/Kelee/AOOMEE 快照、高德、Spotify、支付宝与瓜子影视等独立来源；不含 R-Store base。
#!author=Romeo / RuCu6（Amap）/ zirawell / ddgksf2013（本仓库自动构建）
#homepage=https://github.com/XcvcvX/loon-independent-plugins
#!merged-at=2026-11-19 15:50 UTC
#!note=本预览不含 R-Store base；独立 App 插件与专项规则按来源合并，覆盖范围低于原综合版。
#!sources=Romeo-independent-App+Romeo-Spotify+RuCu6-Amap+zirawell-AlipayAdBlock+ddgksf2013/GuaZiVideoAds

[Argument]
12306_enable = switch,true,false,tag=12306-脚本开关
background_playback = switch,false,tag=后台播放,desc=切换应用或锁屏后，普通视频仍可继续播放音频。直播和受限内容仍由 YouTube 决定
playback_region = select,"original","CN","HK","TW","US","JP","KR","SG","GB","DE","RU",tag=播放请求地区,desc=original 保持当前地区。此项只修改客户端 gl 参数，不改变出口 IP。对去广告的影响仍待验证
translation_enabled = switch,false,tag=字幕翻译,desc=将已有字幕翻译成所选目标语言。关闭后保留原始字幕请求
translation_target = select,"zh-CN","en-US",tag=字幕目标语言,desc=只转换已有字幕轨道（简体中文 zh-CN 或美式英语 en-US）。没有字幕的视频无法翻译；音轨、标题和简介保持不变
hide_home_shorts = switch,false,tag=隐藏首页 Shorts,desc=从首页信息流移除 Shorts 内容栏；底部 Shorts 标签和其他页面保留
blocked_channels = input,"",tag=屏蔽频道,desc=填写频道 ID、@用户名或完整频道名，多个条目以空格分隔。优先使用频道 ID；频道名含空格时请填用户名或 ID。留空则停用。只隐藏能识别出所属频道的视频
blocked_channels_url = input,"",tag=远程屏蔽频道列表,desc=公开的 HTTPS 纯文本直链（例如 GitHub Raw）。本地缓存每小时刷新，也可手动运行更新脚本。列表会与手动填写内容合并；留空则停用
log_enabled = switch,false,tag=日志工具,desc=首次命中匹配请求时自动启动，并通知日志入口。关闭后，下一个 API 请求会清除日志并停止采样；如需保留请先下载。完整采样可能增加延迟
quality_research = switch,false,tag=画质分析采样,desc=仅在日志工具开启时生效。记录可识别的画质和格式参数，并读取少量媒体 POST 请求用于比较；不会自动切换画质
media_capture_mode = select,"headers","full",tag=媒体采样模式,desc=仅在日志工具开启时生效，关闭日志时自动停用。headers 只记录响应头；full 会读取完整响应内容用于开发，可能增加延迟
log_level = select,"info","debug","warn","error",tag=日志等级,desc=info 保留完整脱敏跟踪记录；error 只保留错误；debug 保留调试信息；warn 保留警告和错误
capture_budget = select,"32","16","64",tag=日志容量（MB）,desc=达到上限后停止记录，并保留已有样本。导出后可清理
blockUpload=switch,true,false,tag=屏蔽上传按钮, desc=屏蔽上传按钮
blockImmersive=switch,true,false,tag=屏蔽选段按钮, desc=屏蔽选段按钮
blockShorts=switch,false,true,tag=屏蔽Shorts按钮, desc=屏蔽Shorts按钮
captionLang=input,off,tag=字幕翻译语言, desc=字幕翻译语言
debug=switch,false,true,tag=启用调试模式, desc=启用调试模式

